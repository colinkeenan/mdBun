[Desktop Entry]
Comment=Display .md file as HTML in default browser, or a folder as a list of its .md files
Exec=/usr/local/bin/md %f
MimeType=text/markdown;inode/directory;
Icon=/home/colin/.local/share/icons/hicolor/64x64/md.png
Name=mdBun
NoDisplay=false
Path=
PrefersNonDefaultGPU=false
StartupNotify=true
Terminal=false
TerminalOptions=
Type=Application
X-KDE-SubstituteUID=false
X-KDE-Username=
